# Copy this to .env and fill in your values
NODE_ENV=development
PORT=4001
ISSUER_URL=http://localhost:4001
AUTH_CLIENT_ID=vibe-survival-game-client

# Required in production. Development uses a chmod-600 JSON file when unset.
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Generate JWT keys using: node generate-keys.js
JWT_PRIVATE_KEY=your_private_key_here
JWT_PUBLIC_KEY=your_public_key_here

# Email verification and password-reset delivery. Both are required in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity (must be a verified sender/domain in Resend)
# Example: SpacetimeDB Auth Demo <noreply@yourdomain.com>
RESEND_FROM=SpacetimeDB Auth Demo <noreply@example.com>

# CORS whitelist — required in production and restricted to HTTPS origins.
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
# ALLOWED_ORIGINS=https://myapp.com

# Optional explicit OIDC callback whitelist. Defaults to /callback on each
# ALLOWED_ORIGINS entry and on ISSUER_URL.
# ALLOWED_REDIRECT_URIS=https://myapp.com/callback

# Set only when the auth server is reachable exclusively through a trusted
# reverse proxy that overwrites forwarding headers.
# TRUST_PROXY=true

# The production process refuses to start unless ISSUER_URL, DATABASE_URL,
# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, RESEND_API_KEY, RESEND_FROM, and
# ALLOWED_ORIGINS are all explicitly configured.
