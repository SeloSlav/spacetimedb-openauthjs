# Optional: Auth server URL (default: http://localhost:4001 in dev)
# VITE_AUTH_SERVER_URL=http://localhost:4001

# Optional: OIDC client ID (default: vibe-survival-game-client)
# VITE_AUTH_CLIENT_ID=vibe-survival-game-client

# Optional SpacetimeDB endpoint overrides. These are useful for staging or when
# the browser hostname is not enough to determine the target database.
# VITE_SPACETIME_URI=http://localhost:3000
# VITE_SPACETIME_DB_NAME=spacetimedb-auth-demo-local
